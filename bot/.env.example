# Токен бота из @BotFather
BOT_TOKEN=1234567890:AAA-fake-token-for-example

# Telegram id администраторов через запятую
ADMIN_IDS=111111111

# Публичный HTTPS-адрес каталога для кнопки Mini App (Telegram требует https)
# Локально: поднять туннель (cloudflared/ngrok) на web:3000 или на nginx :8080
WEB_APP_URL=https://your-demo.example.com

# Подключение к БД (в compose подставляется автоматически)
DATABASE_URL=postgresql://catalog:catalog@postgres:5432/catalog

# MinIO (в compose endpoint подставляется автоматически)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=http://localhost:9000
# Необязательно: socks5-прокси до Telegram (для сетей с блокировкой), пусто = напрямую
TG_PROXY=socks5://127.0.0.1:1080
